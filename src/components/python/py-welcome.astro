---
// Read the Python file content to execute in browser
import fs from 'fs';
import { fileURLToPath } from 'url';
import path from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const scriptPath = path.join(__dirname, 'PythonWelcome.py');
const pythonCode = fs.readFileSync(scriptPath, 'utf-8');
---

<p id="python-output" style="color: #3776ab;">Loading Python...</p>

<script define:vars={{ pythonCode }}>
  async function runPython() {
    try {
      // @ts-ignore
      const pyodide = await loadPyodide();
      // Capture stdout
      pyodide.setStdout({ batched: (msg) => {
        document.getElementById('python-output').textContent = msg;
      }});
      await pyodide.runPythonAsync(pythonCode);
    } catch (error) {
      document.getElementById('python-output').textContent = 'Error: ' + error.message;
    }
  }
  runPython();
</script>
<script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>