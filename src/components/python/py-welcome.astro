---
import { spawnSync } from 'child_process';
import { fileURLToPath } from 'url';
import path from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const scriptPath = path.join(__dirname, 'PythonWelcome.py');

function runPythonScript() {
  const candidates = [
    'python',
    'py',
    'python3',
    '/usr/bin/python3',
    '/usr/local/bin/python3',
    'C:\\Python311\\python.exe',
    'C:\\Python312\\python.exe'
  ];

  for (const cmd of candidates) {
    try {
      const res = spawnSync(cmd, [scriptPath], {
        encoding: 'utf8',
        env: { ...process.env },
        stdio: ['pipe', 'pipe', 'pipe']
      });

      if (!res.error && res.status === 0 && res.stdout) {
        return res.stdout.trim();
      }
    } catch {
      continue;
    }
  }

  return '🐍 Python component (Python not available during local build)';
}

const output = runPythonScript();
---

<p style="color: #3776ab;">{output}</p>