---
import { spawnSync } from 'child_process';
import { fileURLToPath } from 'url';
import path from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const scriptPath = path.join(__dirname, 'hello-world.php');

function runPhpScript() {
  const candidates = [
    'php',
    '/usr/bin/php',
    '/usr/local/bin/php',
    'php-cli',
    'C:\\php\\php.exe',
    'C:\\Program Files\\php\\php.exe'
  ];
  
  for (const cmd of candidates) {
    try {
      const res = spawnSync(cmd, [scriptPath], { 
        encoding: 'utf8',
        env: { ...process.env },
        stdio: ['pipe', 'pipe', 'pipe']
      });
      
      // Success - PHP executed without error
      if (!res.error && res.status === 0 && res.stdout) {
        return res.stdout.trim();
      }
    } catch (err) {
      // Silently continue to next candidate
      continue;
    }
  }
  
  // PHP not found - return fallback message
  return '🚀 PHP component (PHP not available during local build)';
}

const output = runPhpScript();
---

<p style="color: #777bb4;">{output}</p>
